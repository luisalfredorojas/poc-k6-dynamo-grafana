{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "K6GatewayReadOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
